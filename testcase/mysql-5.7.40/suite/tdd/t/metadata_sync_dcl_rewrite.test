    DELIMITER |;
    CREATE OR REPLACE PACKAGE pkg1 AS
      FUNCTION f1 ( id INT ) RETURN DECIMAL(10,2);
      PROCEDURE sp1 ( id INT, amount DECIMAL(10,2) );
      PROCEDURE sp2 ( id INT );
      PROCEDURE sp3 ( name TEXT, salary DECIMAL(10,2) );
