#case 22933

--source include/have_sequoiadb.inc
--source suite/metadata_sync_sequoiadb/inc/insts_connect_sequoiadb.inc

# connect to conn1, clear user at the beginning
connection conn1;
--disable_warnings
DROP USER IF EXISTS u1, u2, u3, u4, u5;
DROP USER IF EXISTS dcl_rewrite_user1, dcl_rewrite_user2, dcl_rewrite_user3, dcl_rewrite_user4, dcl_rewrite_user5, dcl_rewrite_user6, dcl_rewrite_user7;
set debug="d,test_point_ha_rewritten_query";

let $is_mariadb = `SELECT VERSION() regexp "MariaDB"`;

# create multiple users at the same time 
CREATE USER u1 IDENTIFIED BY 'u1_pwd', u2 IDENTIFIED BY 'u2_pwd', u3 IDENTIFIED BY PASSWORD '*BB4B43988AC348E7785389DB96E151E6F20AF166', u4 IDENTIFIED BY 'u4_pwd', u5 IDENTIFIED BY PASSWORD '*435D388DA987BA3E54CEDCE714335437D9A6066B';
SELECT @HA_REWRITTEN_QUERY_BEFORE_EXECUTION;
SELECT @HA_REWRITTEN_QUERY_AFTER_EXECUTION;
SHOW CREATE USER u1;
SHOW CREATE USER u2;
SHOW CREATE USER u3;
SHOW CREATE USER u4;
SHOW CREATE USER u5;
connection conn2;
SHOW CREATE USER u1;
SHOW CREATE USER u2;
SHOW CREATE USER u3;
SHOW CREATE USER u4;
SHOW CREATE USER u5;

# alter multiple users at the same time 
connection conn1;
ALTER USER u1 IDENTIFIED BY 'uu1_pwd', u2 IDENTIFIED BY 'uu2_pwd', u3 IDENTIFIED BY 'uu3_pwd', u4 IDENTIFIED BY 'uu4_pwd', u5 IDENTIFIED BY 'uu5_pwd';
SELECT @HA_REWRITTEN_QUERY_BEFORE_EXECUTION;
SELECT @HA_REWRITTEN_QUERY_AFTER_EXECUTION;
SHOW CREATE USER u1;
SHOW CREATE USER u2;
SHOW CREATE USER u3;
SHOW CREATE USER u4;
SHOW CREATE USER u5;
connection conn2;
SHOW CREATE USER u1;
SHOW CREATE USER u2;
SHOW CREATE USER u3;
SHOW CREATE USER u4;
SHOW CREATE USER u5;

# grant multiple users at the same time 
connection conn1;
GRANT ALL PRIVILEGES on *.* TO u1 IDENTIFIED BY 'u1_pwd', u2 IDENTIFIED BY 'u2_pwd', u3 IDENTIFIED BY PASSWORD '*BB4B43988AC348E7785389DB96E151E6F20AF166', u4 IDENTIFIED BY 'u4_pwd', u5 IDENTIFIED BY PASSWORD '*435D388DA987BA3E54CEDCE714335437D9A6066B';
SELECT @HA_REWRITTEN_QUERY_BEFORE_EXECUTION;
SELECT @HA_REWRITTEN_QUERY_AFTER_EXECUTION;
SHOW CREATE USER u1;
SHOW CREATE USER u2;
SHOW CREATE USER u3;
SHOW CREATE USER u4;
SHOW CREATE USER u5;
connection conn2;
SHOW CREATE USER u1;
SHOW CREATE USER u2;
SHOW CREATE USER u3;
SHOW CREATE USER u4;
SHOW CREATE USER u5;

connection conn1;
DROP USER IF EXISTS u1, u2, u3, u4, u5;

