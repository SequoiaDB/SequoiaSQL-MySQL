    connection conn1;
    # test grant with grant option
    GRANT ALL PRIVILEGES ON *.* TO dcl_rewrite_user1 IDENTIFIED BY 'dcl_user_passwd1', dcl_rewrite_user2 IDENTIFIED BY 'dcl_user_passwd2' WITH GRANT OPTION;
