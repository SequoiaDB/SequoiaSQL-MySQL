# The include statement below is a temp one for tests that are yet to
#be ported to run with Sequoiadb.

# 
# Run subquery_sj_all.test with BKA enabled 
#

--disable_warnings
drop database if exists subquery_sj_all_bka;
--enable_warnings

create database subquery_sj_all_bka;
use subquery_sj_all_bka;

set optimizer_switch='batched_key_access=on,mrr_cost_based=off';

--source t/subquery_sj_all.test

set optimizer_switch=default;

drop database subquery_sj_all_bka;
