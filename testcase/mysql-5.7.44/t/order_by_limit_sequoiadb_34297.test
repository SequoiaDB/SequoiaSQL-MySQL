DROP DATABASE order_by_limit_sequoiadb_34297;
CREATE DATABASE order_by_limit_sequoiadb_34297;
USE order_by_limit_sequoiadb_34297;

#set optimizer_index_sort_prune = on;

--disable_warnings
DROP TABLE IF EXISTS t1,t2;
--enable_warnings

CREATE TABLE `tb1` (
  `idx_match_field` int(11) DEFAULT NULL,
  `other_match_field` int(11) DEFAULT NULL,
  `order_field` int(11) DEFAULT NULL,
  KEY `idx_match_field` (`idx_match_field`),
  KEY `order_field` (`order_field`)
);

CREATE TABLE `tb2` (
  `idx_match_field` int(11) DEFAULT NULL,
  `other_match_field` int(11) DEFAULT NULL,
  `order_field` int(11) DEFAULT NULL,
  KEY `idx_match_field` (`idx_match_field`),
  KEY `order_field` (`order_field`)
) ENGINE=SequoiaDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin COMMENT='sequoiadb:{table_options: {ShardingKey: {order_field: 1 } }}';

INSERT INTO tb1 VALUES( 1, 0, 1 ), ( 2, 0, 2 ), ( 3, 0, 3 ), ( 4, 0, 4 ), ( 5, 0, 5 ), ( 6, 0, 6 ), ( 7, 0, 7 ), ( 8, 0, 8 ), ( 9, 0, 9 ), ( 10, 0, 10 ), ( 10, 0, 11 ), ( 10, 0, 12 ), ( 10, 0, 13 ), ( 10, 0, 14 ), ( 10, 0, 15 ), ( 10, 0, 16 ), ( 10, 0, 17 ), ( 10, 0, 18 ), ( 10, 0, 19 ), ( 10, 0, 20 );

INSERT INTO tb2 VALUES( 1, 0, 1 ), ( 2, 0, 2 ), ( 3, 0, 3 ), ( 4, 0, 4 ), ( 5, 0, 5 ), ( 6, 0, 6 ), ( 7, 0, 7 ), ( 8, 0, 8 ), ( 9, 0, 9 ), ( 10, 0, 10 ), ( 10, 0, 11 ), ( 10, 0, 12 ), ( 10, 0, 13 ), ( 10, 0, 14 ), ( 10, 0, 15 ), ( 10, 0, 16 ), ( 10, 0, 17 ), ( 10, 0, 18 ), ( 10, 0, 19 ), ( 10, 0, 20 );

ANALYZE TABLE tb1;

ANALYZE TABLE tb2;

--disable_warnings
EXPLAIN SELECT * FROM tb1 WHERE idx_match_field = 10 AND other_match_field = 0 ORDER BY order_field LIMIT 1;

--disable_warnings
EXPLAIN SELECT * FROM tb2 WHERE idx_match_field = 10 AND other_match_field = 0 ORDER BY order_field LIMIT 1;

