DROP DATABASE order_by_limit_sequoiadb_34298;
CREATE DATABASE order_by_limit_sequoiadb_34298;
USE order_by_limit_sequoiadb_34298;

#set optimizer_index_sort_prune = on;
#set global sequoiadb_auto_partition = on;
set sequoiadb_debug_log = on;
set sequoiadb_secure_log = off;

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

create table t1( pk int, a int, b int, c int, primary key(pk), key( a ), key( b ), key( c ) );

insert into t1 values(1, 1, 0, 1 ), (2, 2, 0, 2 ), (3, 3, 0, 3 ), (4, 4, 0, 4 ), (5, 5, 0, 5 ), (6, 6, 0, 6 ), (7, 7, 0, 7 ), (8, 8, 0, 8 ), (9, 9, 0, 9 ), (10, 10, 0, 10 ), (11, 10, 0, 11 ), (12, 10, 0, 12 ), (13, 10, 0, 13 ), (14, 10, 0, 14 ), (
15, 10, 0, 15 ), ( 16, 10, 0, 16 ), ( 17, 10, 0, 17 ), ( 18, 10, 0, 18 ), ( 19, 10, 0, 19 ), ( 20, 10, 0, 20 );

ANALYZE TABLE t1;

#const
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE pk = 1;
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE pk = 1 ORDER BY c LIMIT 1;
SELECT * FROM t1 WHERE pk = 1;
--source include/query_pushdown_condition_sequoiadb.inc
SELECT * FROM t1 WHERE pk = 1 ORDER BY c LIMIT 1;
--source include/query_pushdown_condition_sequoiadb.inc

#ref
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE a = 10 AND b IS NOT NULL;
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE a = 10 AND b IS NOT NULL ORDER BY c LIMIT 1;
SELECT * FROM t1 WHERE a = 10 AND b IS NOT NULL;
--source include/query_pushdown_condition_sequoiadb.inc
SELECT * FROM t1 WHERE a = 10 AND b IS NOT NULL ORDER BY c LIMIT 1;
--source include/query_pushdown_condition_sequoiadb.inc

#ref_or_null
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE a = 1 OR a IS NULL AND b IS NOT NULL;
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE a = 1 OR a IS NULL AND b IS NOT NULL ORDER BY c LIMIT 1;
SELECT * FROM t1 WHERE a = 1 OR a IS NULL AND b IS NOT NULL;
--source include/query_pushdown_condition_sequoiadb_2.inc
SELECT * FROM t1 WHERE a = 1 OR a IS NULL AND b IS NOT NULL ORDER BY c LIMIT 1;
--source include/query_pushdown_condition_sequoiadb.inc

#index_merge
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE a = 1 OR b = 1;
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE a = 1 OR b = 1 ORDER BY c LIMIT 1;
SELECT * FROM t1 WHERE a = 1 OR b = 1;
--source include/query_pushdown_condition_sequoiadb_2.inc
SELECT * FROM t1 WHERE a = 1 OR b = 1 ORDER BY c LIMIT 1;
--source include/query_pushdown_condition_sequoiadb_2.inc

#range
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE a BETWEEN 1 AND 5;
--disable_warnings
EXPLAIN SELECT * FROM t1 WHERE a BETWEEN 1 AND 5 ORDER BY c LIMIT 1;
SELECT * FROM t1 WHERE a BETWEEN 1 AND 5;
--source include/query_pushdown_condition_sequoiadb.inc
SELECT * FROM t1 WHERE a BETWEEN 1 AND 5 ORDER BY c LIMIT 1;
--source include/query_pushdown_condition_sequoiadb.inc

#ALL
