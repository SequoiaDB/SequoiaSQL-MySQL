create view v5 as select t1.a,t2.b from t1 join t2 where t1.a = t2.b;
create table mt5 as select * from v5 maintained by user enable query optimization;
create view v6 as select distinct * from t1 where a = 1;
create table mt6 as select * from v6 maintained by user enable query optimization;
explain select * from v6;
