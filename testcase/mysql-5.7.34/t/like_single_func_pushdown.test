#seqDB-26641
--source include/have_sequoiadb.inc

create database like_single_func_pushdown;
--disable_warnings
drop database if exists like_single_func_pushdown;
--enable_warnings

create database like_single_func_pushdown;
use like_single_func_pushdown;
set session sequoiadb_debug_log=on;
set session sequoiadb_support_mode='';

--disable_warnings
drop table if exists t1, t2, t3, t4, t5;
--enable_warnings

create table t1(
    a varchar(514) charset utf8mb4 collate utf8mb4_bin
);
create table t2(
    a varchar(20) charset utf8mb4 collate utf8mb4_bin
);
create table t3(
    a set('a1','b2','c3') charset utf8mb4 collate utf8mb4_bin
);
create table t4(
    a int
);
create table t5(
    a varchar(20) charset utf8mb4 collate utf8mb4_unicode_ci
);

#-----------------string functions----------------------#

#ascii
