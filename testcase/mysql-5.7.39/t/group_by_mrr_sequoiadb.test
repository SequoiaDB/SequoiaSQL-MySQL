let $i = 2;

while ($i)
{
if ($i == 2) 
{
SET SESSION optimizer_index_sort_prune=ON;
SET SESSION optimizer_switch="optimizer_sort_pushdown=on";
}

if ($i == 1)
{
SET SESSION optimizer_index_sort_prune=OFF;
SET SESSION optimizer_switch="optimizer_sort_pushdown=off";
ALTER TABLE normal_table ENGINE = InnoDB;
ALTER TABLE list_part_table ENGINE = InnoDB;
ALTER TABLE hash_part_table ENGINE = InnoDB;
ALTER TABLE range_part_table ENGINE = InnoDB;
ALTER TABLE son_part_table ENGINE = InnoDB;
}

--disable_warnings
SELECT ALL `col_int_key` AS field1 FROM list_part_table PARTITION (p0 , p0 , p3 ) WHERE not col_int_key = 9 GROUP BY field1 HAVING field1 > 0;

SELECT DISTINCT HIGH_PRIORITY `col_datetime_key` AS field1 FROM hash_part_table WHERE not col_datetime_key BETWEEN '2001-12-23 19:39:32' AND '2006-03-11 19:50:51' GROUP BY field1 HAVING field1 > 1;

SELECT DISTINCT HIGH_PRIORITY `col_double_key` AS field1 FROM range_part_table WHERE not col_double_key = ( SELECT pk AS subselect FROM `normal_table` WHERE ( not not ( (not (not (not (( not not col_varchar_16 not like '%e%') AND ( not ( not strcmp('m' , 'l')) OR ( not not (not (not pk = ( SELECT col_int AS subselect FROM `son_part_table` WHERE not ( col_int = ( SELECT col_double AS subselect FROM `range_part_table` WHERE col_int = ( SELECT pk AS subselect FROM `hash_part_table` WHERE strcmp('e' , 'u') ORDER BY subselect limit 1 ) ORDER BY subselect limit 1 )) ORDER BY subselect limit 1 ))))))))))) AND ( not not (not col_double_key <=> 1)) ORDER BY subselect limit 1 ) GROUP BY field1 HAVING field1 > 0 ORDER BY /*RESULTSETS_HAS_SAME_ORDER*/ field1;

SELECT ALL SQL_CACHE `col_double_key` AS field1 FROM list_part_table WHERE not col_double_key = ( SELECT col_double AS subselect FROM `normal_table` WHERE ( not ( not not (( not not (not col_double <=> 6)) OR ( exists ( SELECT col_varchar_16 AS subselect FROM `normal_table` WHERE not (( col_varchar_16_key <=> '') OR ( not not greatest(8,6,0))) ORDER BY subselect )))) OR ( not not MOD( col_double, 7 ) = 0)) AND ( ( not ( not col_varchar_16 not regexp '^f') OR ( not not col_varchar_16 in ( SELECT col_varchar_16_key AS subselect FROM `hash_part_table` WHERE (not ( isnull(''))) ORDER BY subselect ))) AND ( not not col_double >= 4)) ORDER BY subselect limit 1 ) GROUP BY field1 HAVING field1 > 0;

SELECT ALL SQL_SMALL_RESULT SUM( col_double ) AS field1, `col_datetime_key` AS field2, MAX( distinct col_varchar_16 ) AS field3, `col_double_key` AS field4, SUM( col_int ) AS field5 FROM list_part_table PARTITION (p1 , p0 , p0 , p3 ) WHERE not col_varchar_16 <=> '' GROUP BY field2, field4 HAVING ((field3 = 5 OR field4 IS NULL AND field4 = 2) XOR field3 = 0 OR field5 IS NULL);
--enable_warnings

dec $i;
}

SET SESSION optimizer_index_sort_prune=DEFAULT;
SET SESSION optimizer_switch="optimizer_sort_pushdown=default";

DROP DATABASE group_by_mrr_sequoiadb;

--source include/uninstall_sequoiadb.inc
