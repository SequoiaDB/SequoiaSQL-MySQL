# Case 31059, Case 31060, Case 31061, Case 31062, Case 31063
--source include/have_sequoiadb.inc
--source include/have_partition.inc
--source suite/metadata_sync_sequoiadb/inc/insts_connect_sequoiadb.inc

let $i = 2;
while ($i) {
connection conn1;
if ($i == 2) {
    let $table = normal_table;
    set session sequoiadb_execution_mode = 0;
}
if ($i == 1) {
    let $table = list_table;
    set session sequoiadb_execute_only_in_mysql = off;
}

--disable_warnings
DROP DATABASE IF EXISTS execution_sync_sequoiadb; 
--enable_warnings
CREATE DATABASE execution_sync_sequoiadb;
USE execution_sync_sequoiadb;

eval CREATE TABLE $table(pk int, col1 int, col2 int, col3 varchar(10), col4 datetime) ENGINE=SequoiaDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

if ($table == list_table) {
    eval ALTER TABLE $table PARTITION BY LIST COLUMNS(pk) (
    PARTITION p0 VALUES IN (1, 2) ENGINE = SequoiaDB,
    PARTITION p1 VALUES IN (3, 4) ENGINE = SequoiaDB,
    PARTITION p2 VALUES IN (5, 6) ENGINE = SequoiaDB,
    PARTITION p3 VALUES IN (7, 8) ENGINE = SequoiaDB);
}
    
eval INSERT INTO $table VALUES
(1, 1, 1, 'ZXCF', '2023-04-08 10:21:11'),
(2, 2, 2, 'CXCG', '2023-04-09 11:22:12'),
(3, 3, 3, 'ZXCV', '2023-04-10 12:23:13'),
(4, 4, 4, 'ZXAD', '2023-04-11 13:24:14');

connection conn2;
USE execution_sync_sequoiadb;

eval ALTER TABLE $table ADD COLUMN col5 varchar(10) DEFAULT 'ABCD';
eval INSERT INTO $table VALUES(5, 5, 5, 'ZBCK', '2023-04-12 14:25:15', 'DCBA');

connection conn1;
USE execution_sync_sequoiadb;

# eval SELECT * FROM $table order by pk;  ##SEQUOIASQLMAINSTREAM-1817
eval SELECT pk, col1, col2, col3, col4, col5 FROM $table order by pk;
eval DELETE FROM $table WHERE pk BETWEEN 1 AND 2;

connection conn2;
USE execution_sync_sequoiadb;

eval ALTER TABLE $table DROP COLUMN col2;
eval SELECT * FROM $table order by pk;

DROP DATABASE execution_sync_sequoiadb;

dec $i;
}


let $i = 2;
while ($i) {
connection conn1;

--disable_warnings
DROP DATABASE IF EXISTS execution_sync_sequoiadb;
--enable_warnings
CREATE DATABASE execution_sync_sequoiadb;
USE execution_sync_sequoiadb;

if ($i == 2) {
    let $table = key_table;
}
if ($i == 1) {
    let $table = hash_table;
}

eval CREATE TABLE $table(pk int, col1 int, col2 int, col3 varchar(10), col4 datetime) ENGINE=SequoiaDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

if ($table == key_table) {
    eval ALTER TABLE $table PARTITION BY KEY (pk) PARTITIONS 4;
}

if ($table == hash_table) {
    eval ALTER TABLE $table PARTITION BY HASH (pk) PARTITIONS 4;
}

eval INSERT INTO $table VALUES
(1, 1, 1, 'ZXCF', '2023-04-08 10:21:11'),
(2, 2, 2, 'CXCG', '2023-04-09 11:22:12'),
(3, 3, 3, 'ZXCV', '2023-04-10 12:23:13'),
(4, 4, 4, 'ZXAD', '2023-04-11 13:24:14');

if ($i == 2) {
    set session sequoiadb_execution_mode = 1;
}
if ($i == 1) {
    set session sequoiadb_execute_only_in_mysql = on;
}

eval ALTER TABLE $table ADD COLUMN col5 varchar(10) DEFAULT 'ABCD';
eval INSERT INTO $table VALUES(5, 5, 5, 'ZBCK', '2023-04-12 14:25:15', 'DCBA');
eval SELECT * FROM $table order by pk;

connection conn2;
USE execution_sync_sequoiadb;

eval SELECT * FROM $table order by pk;
eval ALTER TABLE $table ADD COLUMN col5 varchar(10) DEFAULT 'ABCD';
eval INSERT INTO $table VALUES(5, 5, 5, 'ZBCK', '2023-04-12 14:25:15', 'DCBA');

connection conn1;
set session sequoiadb_execution_mode = 0;
USE execution_sync_sequoiadb;

eval SELECT * FROM $table order by pk;
eval DELETE FROM $table WHERE pk BETWEEN 1 AND 2;
eval ALTER TABLE $table DROP COLUMN col2;

connection conn2;
USE execution_sync_sequoiadb;

# eval SELECT * FROM $table order by pk; ##SEQUOIASQLMAINSTREAM-1817
eval SELECT pk, col1, col3, col4, col5 FROM $table order by pk;

DROP DATABASE execution_sync_sequoiadb;

dec $i;
}


connection conn1;
set session sequoiadb_execution_mode = 0;

--disable_warnings
DROP DATABASE IF EXISTS execution_sync_sequoiadb; 
--enable_warnings
CREATE DATABASE execution_sync_sequoiadb;
USE execution_sync_sequoiadb;

CREATE TABLE range_table(pk int, col1 int, col2 int, col3 varchar(10), col4 datetime) 
ENGINE=SequoiaDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin 
PARTITION BY RANGE COLUMNS(pk) (
PARTITION p0 VALUES LESS THAN (2) ENGINE = SequoiaDB,
PARTITION p1 VALUES LESS THAN (4) ENGINE = SequoiaDB,
PARTITION p2 VALUES LESS THAN (6) ENGINE = SequoiaDB,
PARTITION p3 VALUES LESS THAN (MAXVALUE) ENGINE = SequoiaDB);

set session sequoiadb_execution_mode = 2;

INSERT INTO range_table VALUES
(1, 1, 1, 'ZXCF', '2023-04-08 10:21:11'),
(2, 2, 2, 'CXCG', '2023-04-09 11:22:12');

SELECT * FROM range_table order by pk;

connection conn2;
USE execution_sync_sequoiadb;

SELECT * FROM range_table order by pk;
ALTER TABLE range_table ADD COLUMN col5 varchar(10) DEFAULT 'ABCD';
INSERT INTO range_table VALUES
(3, 3, 3, 'ZBCK', '2023-04-12 14:25:15', 'DCBA'),
(4, 4, 4, 'ZTUF', '2023-04-13 15:26:15', 'FDBP');

connection conn1;
USE execution_sync_sequoiadb;

--sleep 3
SELECT * FROM range_table order by pk;
ALTER TABLE range_table ADD COLUMN col6 varchar(10) DEFAULT 'ASDF';

connection conn2;
USE execution_sync_sequoiadb;

--sleep 3
SELECT * FROM range_table order by pk;
ALTER TABLE range_table DROP COLUMN col2;
SELECT * FROM range_table order by pk;

DROP DATABASE execution_sync_sequoiadb;


--source include/uninstall_sequoiadb.inc
--source suite/metadata_sync_sequoiadb/inc/insts_disconnect_sequoiadb.inc

